DATABASE_URL="file:./dev.db"
PORT=4001
NODE_ENV=development
JWT_SECRET=change-moi-en-production-tres-long-et-aleatoire
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads

# Webhooks paiements — requis en production (sinon HTTP 503)
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_WEBHOOK_SECRET_OLD=

# API Marchande GeniusPay
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_API_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Cron réconciliation GeniusPay (backup webhooks)
GENIUSPAY_RECONCILE_CRON_ENABLED=false
GENIUSPAY_RECONCILE_CRON_INTERVAL_MINUTES=10
GENIUSPAY_RECONCILE_CRON_DAYS=3
